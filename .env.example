# ==============================================================================
# ULTRON MEMORY AGENT — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your credentials and parameters.
# NEVER commit your live .env file to Git.
# ==============================================================================

# ── Core LLM Provider Selection ───────────────────────────────────────────────
# Primary provider for cognition & tool orchestration: 'gemini' | 'openrouter' | 'anthropic'
LLM_PROVIDER=gemini

# API Credentials (provide keys for your chosen provider[s])
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model Complexity Matrix & Dynamic Routing ─────────────────────────────────
# Fast tier for high-throughput triage, extraction, and simple tasks
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FLASH=gemini-3.6-flash

# Deep reasoning tier for complex analysis, Tree-of-Thoughts & code execution
GEMINI_MODEL_THINKING=gemini-3.6-flash

# Claude Models (when using Anthropic provider)
CHAT_MODEL_HAIKU=claude-haiku-4-5-20251001
CHAT_MODEL_SONNET=claude-sonnet-5
CHAT_MODEL=gemini-3.6-flash

# Background memory fact-extraction model (used silently by Mem0)
MEMORY_MODEL=gemini-3.6-flash

# Local Embedding Model (sentence-transformers runs 100% locally, zero cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector Database Configuration ─────────────────────────────────────────────
# Provider: 'chroma' (local zero-docker, default) or 'qdrant' (cluster/server)
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./data/chroma
COLLECTION_NAME=mem0_agent_claude

# Qdrant optional settings (uncomment if VECTOR_STORE_PROVIDER=qdrant)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ── Memory Retrieval & Context Parameters ─────────────────────────────────────
# Number of relevant memories injected into the system context
MEMORY_TOP_K=5

# Turns to wait before re-querying vector store (in between turns use cache)
MEMORY_REFRESH_INTERVAL=3

# Turn batching interval before triggering background fact-extraction
MEMORY_UPDATE_INTERVAL=3

# In-session message pair history depth (older turns are preserved in memory)
MAX_HISTORY_TURNS=10

# ── Budget Guardrails & Cost Controls ─────────────────────────────────────────
# Daily limits. Set to 0 for unlimited.
DAILY_TOKEN_LIMIT=0
DAILY_COST_LIMIT_USD=0.00

# Budget warning trigger threshold (0.80 = warning dispatched at 80% usage)
BUDGET_WARN_THRESHOLD=0.80

# ── Autonomous Tool Execution & Workspace ─────────────────────────────────────
TOOL_EXECUTION_ENABLED=true
TOOL_MAX_ITERATIONS=25
TOOL_COMMAND_TIMEOUT=30
TOOL_PYTHON_TIMEOUT=60
TOOL_WORKSPACE_ROOT=./
TOOL_MAX_OUTPUT_LENGTH=8000

# ── Sovereign Security & Emergency Killswitch ─────────────────────────────────
# Cryptographic secret key required to disengage emergency lockdown
KILLSWITCH_SECRET_KEY=generate_a_secure_random_key_here

# ── Discord Mobile & Desktop Gateway Bridge ───────────────────────────────────
# Discord Bot application token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated Discord User IDs allowed to issue authorized directives
DISCORD_ALLOWED_USER_IDS=

# ── Autonomous Email & Inbox Engine (IMAP/SMTP) ───────────────────────────────
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USE_SSL=true
EMAIL_DEFAULT_PROFILE=primary

# Profile 1 (e.g., Primary / Professional)
primary_EMAIL_USER=
primary_EMAIL_PASSWORD=

# Profile 2 (e.g., Personal / Direct)
REACH_EMAIL_USER=
REACH_EMAIL_PASSWORD=

# Profile 3 (e.g., Fallback / Secondary)
PERSONAL_EMAIL_USER=
PERSONAL_EMAIL_PASSWORD=

# ── External APIs, MCP Servers & Web Automation ───────────────────────────────
MCP_ENABLED=true
GITHUB_PERSONAL_ACCESS_TOKEN=
BRAVE_API_KEY=
APIFY_TOKEN=

# ── Telemetry & Auditing ──────────────────────────────────────────────────────
TELEMETRY_ENABLED=true
TELEMETRY_DB_PATH=./data/telemetry.db
ANONYMIZED_TELEMETRY=false
