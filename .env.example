# ── Anthropic ────────────────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Vector Database (100% Local, Zero Docker Needed) ────────────────────────
# Defaults to ChromaDB stored locally in ./data/chroma. No background services required!
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./data/chroma
COLLECTION_NAME=mem0_agent_claude

# ── Models ────────────────────────────────────────────────────────────────────
# You → Sonnet (all chat responses, always)
# Verify latest model IDs: https://docs.anthropic.com/en/docs/about-claude/models
CHAT_MODEL=claude-sonnet-5

# Haiku → background only (fact extraction, memory ADD/UPDATE/DELETE)
# You never see Haiku's output directly — it works silently behind the scenes.
MEMORY_MODEL=claude-haiku-4-5-20251001


# Local embeddings — runs on your machine, downloaded once (~90 MB), FREE
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Memory tuning ─────────────────────────────────────────────────────────────
# How many memories to inject into the system prompt
MEMORY_TOP_K=5

# Re-query memory every N turns (personal signals always trigger immediate refresh)
MEMORY_REFRESH_INTERVAL=3

# Batch N turns before calling Haiku for memory update
# Personal signals always trigger an immediate update regardless
MEMORY_UPDATE_INTERVAL=3

# ── Conversation history ──────────────────────────────────────────────────────
# Max user+assistant PAIRS to keep in context window (older turns live in memory)
MAX_HISTORY_TURNS=10

# ── Budget / cost control ─────────────────────────────────────────────────────
# Hard caps per day. Set 0 for unlimited.
# Example: DAILY_COST_LIMIT_USD=2.00  stops the agent after $2 spend
DAILY_TOKEN_LIMIT=0
DAILY_COST_LIMIT_USD=0

# Warn at this fraction of the daily budget (0.80 = warn at 80%)
BUDGET_WARN_THRESHOLD=0.80

# ── Discord Mobile & Desktop Command Bridge ───────────────────────────────────
# 1. Visit: https://discord.com/developers/applications
# 2. Create Application -> 'Bot' tab -> Reset Token & Copy
# 3. Under 'Privileged Gateway Intents', turn ON: 'Message Content Intent'
# 4. Paste Token below:
DISCORD_BOT_TOKEN=
# Optional: Lock bot exclusively to your Discord User ID (e.g. 123456789012345678)
DISCORD_ALLOWED_USER_IDS=



